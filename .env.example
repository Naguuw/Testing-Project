# Alamat situs dan akun uji mahasiswa
SUNAN_URL=https://sunan.umk.ac.id
SUNAN_PENGGUNA=
SUNAN_SANDI=
# Alamat halaman tugas yang dipakai uji unggah berkas (Home > Courses > tugas)
SUNAN_URL_TUGAS=

# Peramban: chrome, chromium, atau brave
PERAMBAN=chrome
HEADLESS=1
# Browser dan driver boleh diisi bila tidak ditemukan otomatis
BROWSER_BINARY=
CHROMEDRIVER_PATH=

# Batas waktu dalam detik
WAKTU_TUNGGU=15
WAKTU_CAPTCHA=120

# Batas ukuran unggah yang diuji, mengikuti BR-01 (5 MB)
BATAS_UNGGAH_MB=5
