# Alamat situs dan akun uji mahasiswa
SUNAN_URL=https://sunan.umk.ac.id
SUNAN_PENGGUNA=
SUNAN_SANDI=
# Alamat halaman tugas yang dipakai uji upload berkas (Home > Courses > tugas)
SUNAN_URL_TUGAS=

# Browser yang diuji: chrome, firefox, edge (boleh dipisah koma)
BROWSER_UJI=chrome,firefox
HEADLESS=1

# Lokasi browser dan web driver; kosongkan bila ditemukan otomatis
BINER_CHROME=
DRIVER_CHROME=
BINER_FIREFOX=
DRIVER_FIREFOX=
BINER_EDGE=
DRIVER_EDGE=

# Batas waktu dalam detik
WAKTU_TUNGGU=30
WAKTU_CAPTCHA=120
# Batas waktu upload berkas besar, default 90 detik
WAKTU_UPLOAD=90
# Batas ukuran upload yang diuji, --> BR-01 (5 MB)
BATAS_UPLOAD_MB=5
